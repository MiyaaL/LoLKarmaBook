<Application x:Class="LoLKarmaBook.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LoLKarmaBook.Desktop.Converters"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Assets/Icons.xaml" />
        <ResourceDictionary Source="Assets/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
      <conv:StringToVisibilityConverter x:Key="StringToVis" />
      <conv:NullToVisibilityConverter x:Key="NullToVis" />
      <conv:SeverityToBrushConverter x:Key="SeverityBrush" />
      <conv:SeverityTextToBrushConverter x:Key="SeverityTextBrush" />
      <conv:IconKeyToGeometryConverter x:Key="IconGeometry" />
      <conv:CountToVisibilityConverter x:Key="CountToVis" />
      <conv:InverseBoolConverter x:Key="InverseBool" />
      <conv:SelectedBorderBrushConverter x:Key="SelectedBorder" />
      <conv:ChartPointsConverter x:Key="ChartPoints" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
