<UserControl x:Class="LoLKarmaBook.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LoLKarmaBook.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">
  <UserControl.Resources>
    <Style x:Key="PathField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource Size.Small}" />
      <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="设置 / 关于" Style="{StaticResource Text.Title}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardInset}" Margin="0,0,0,10"
              Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.BorderStrong}"
              Visibility="{Binding HasMaintenanceMessage, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Path Data="{StaticResource Icon.Info}" Style="{StaticResource Icon16}" VerticalAlignment="Top" Margin="0,2,0,0"
                Stroke="{Binding MaintenanceSeverity, Converter={StaticResource SeverityTextBrush}}" />
          <TextBlock Grid.Column="1" Text="{Binding MaintenanceMessage}" Style="{StaticResource Text.Body}" Margin="8,0,0,0"
                     Foreground="{Binding MaintenanceSeverity, Converter={StaticResource SeverityTextBrush}}"
                     TextWrapping="Wrap" />
        </Grid>
      </Border>

      <!-- Each column flows independently; short cards never inherit the opposite card's height. -->
      <Grid x:Name="SettingsGrid" SizeChanged="OnSettingsGridSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="SettingsGutter" Width="12" />
          <ColumnDefinition x:Name="SettingsRightColumn" Width="360" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="LeftSettingsColumn" Grid.Column="0" VerticalAlignment="Top">
          <Border x:Name="DataPathsCard" Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="本地数据位置" Style="{StaticResource Text.Heading}" Margin="0,0,0,10" />

              <Border Style="{StaticResource CardInset}" Padding="0">
                <StackPanel>
                  <Grid Height="36" Margin="10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="数据根目录" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding DataRootDisplay, Mode=OneWay}" Style="{StaticResource PathField}"
                             TextWrapping="NoWrap" VerticalAlignment="Center" Margin="8,0"
                             ToolTip="{Binding DataRoot}" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Row}" Padding="6,2"
                            Command="{Binding ChangeDataRootCommand}"
                            ToolTip="更改数据根目录" AutomationProperties.Name="更改数据根目录">
                      <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.Accent}" />
                    </Button>
                  </Grid>
                  <Border Style="{StaticResource Divider}" Margin="10,0" />

                  <Grid Height="36" Margin="10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="数据库" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding DatabaseDisplay, Mode=OneWay}" Style="{StaticResource PathField}"
                             TextWrapping="NoWrap" VerticalAlignment="Center" Margin="8,0"
                             ToolTip="{Binding CurrentDatabasePath}" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Row}" Padding="6,2"
                            Command="{Binding ChangeDatabasePathCommand}"
                            ToolTip="更改当前空间的数据库位置" AutomationProperties.Name="更改当前空间数据库位置">
                      <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.Accent}" />
                    </Button>
                  </Grid>
                  <Border Style="{StaticResource Divider}" Margin="10,0" />

                  <Grid Height="36" Margin="10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设置文件" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SettingsFileDisplay, Mode=OneWay}" Style="{StaticResource PathField}"
                             TextWrapping="NoWrap" VerticalAlignment="Center" Margin="8,0"
                             ToolTip="{Binding SettingsFilePath}" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Row}" Padding="6,2"
                            Command="{Binding ChangeSettingsPathCommand}"
                            ToolTip="更改设置文件位置" AutomationProperties.Name="更改设置文件位置">
                      <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.Accent}" />
                    </Button>
                  </Grid>
                  <Border Style="{StaticResource Divider}" Margin="10,0" />

                  <Grid Height="36" Margin="10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="日志目录" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding LogDirectoryDisplay, Mode=OneWay}" Style="{StaticResource PathField}"
                             TextWrapping="NoWrap" VerticalAlignment="Center" Margin="8,0"
                             ToolTip="{Binding LogDirectoryPath}" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Row}" Padding="6,2"
                            Command="{Binding ChangeLogPathCommand}"
                            ToolTip="更改日志目录" AutomationProperties.Name="更改日志目录">
                      <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.Accent}" />
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border x:Name="PreferencesCard" Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="偏好" Style="{StaticResource Text.Heading}" />
              <StackPanel Margin="0,10,0,0">
                <CheckBox IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                          Content="窗口置顶"
                          AutomationProperties.Name="窗口置顶" />
              </StackPanel>

              <StackPanel Margin="0,0,0,10">
                <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                          IsEnabled="{Binding IsTrayAvailable}"
                          Content="最小化和关闭时收到系统托盘"
                          AutomationProperties.Name="最小化到系统托盘" />
              </StackPanel>

              <StackPanel>
                <TextBlock Text="新记录默认提醒有效期" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                  <TextBox Text="{Binding ReminderDaysText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Width="96" IsEnabled="{Binding CanEditReminderDays}"
                           AutomationProperties.Name="默认提醒有效期天数" />
                  <TextBlock Text="天" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="8,0,18,0" />
                  <CheckBox Content="永久" IsChecked="{Binding IsPermanentReminder, Mode=TwoWay}"
                            VerticalAlignment="Center" AutomationProperties.Name="永久有效" />
                </StackPanel>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding SavePreferencesCommand}"
                        Margin="0,0,8,0" AutomationProperties.Name="保存偏好">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Save}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.OnAccent}" />
                    <TextBlock Text="保存偏好" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Quiet}" Command="{Binding ResetPreferencesCommand}"
                        AutomationProperties.Name="恢复默认偏好">
                  <TextBlock Text="恢复默认" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="DiagnosticsCard" Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
            <Expander IsExpanded="False" HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="展开诊断日志">
              <Expander.Header>
                <TextBlock Text="诊断日志" Style="{StaticResource Text.Heading}" />
              </Expander.Header>
              <StackPanel Margin="0,10,0,0">
                <Button Style="{StaticResource Button.Row}" Command="{Binding RefreshLogCommand}"
                        HorizontalAlignment="Right" Margin="0,0,0,8" AutomationProperties.Name="刷新日志摘要">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.TextMuted}" Width="12" Height="12" />
                    <TextBlock Text="刷新" Margin="5,0,0,0" />
                  </StackPanel>
                </Button>
                <Border Style="{StaticResource CardInset}" Background="{StaticResource Brush.Background}">
                  <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                AutomationProperties.Name="诊断日志内容">
                    <TextBlock Text="{Binding LogTail}" Style="{StaticResource Text.Mono}" Margin="0,0,8,0" />
                  </ScrollViewer>
                </Border>
              </StackPanel>
            </Expander>
          </Border>
        </StackPanel>
        <StackPanel x:Name="RightSettingsColumn" Grid.Column="2" VerticalAlignment="Top">
          <Border x:Name="SnapshotsCard" Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="快照与恢复" Style="{StaticResource Text.Heading}" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding ExportSnapshotCommand}" Margin="0,0,8,0"
                        AutomationProperties.Name="导出快照">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Save}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.OnAccent}" />
                    <TextBlock Text="导出快照" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding RestoreSnapshotCommand}"
                        AutomationProperties.Name="从快照恢复">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Upload}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.Accent}" />
                    <TextBlock Text="从快照恢复" Margin="6,0,0,0" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <Border Style="{StaticResource Divider}" />
              <TextBlock Text="危险操作" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Danger}" />
              <Button Style="{StaticResource Button.Danger}" Command="{Binding ClearProfileCommand}"
                      HorizontalAlignment="Left" AutomationProperties.Name="清空当前空间笔记">
                <TextBlock Text="清空当前空间" />
              </Button>
            </StackPanel>
          </Border>
          <Border x:Name="ProtectionCard" Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="数据保护自检" Style="{StaticResource Text.Heading}" />
              <TextBlock Text="{Binding ProtectorStatus}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border x:Name="AboutCard" Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="关于" Style="{StaticResource Text.Heading}" />
              <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" FontWeight="SemiBold">
                <Run Text="LoLKarmaBook " /><Run Text="{Binding AppVersion, Mode=OneWay, StringFormat=v{0}}" />
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
