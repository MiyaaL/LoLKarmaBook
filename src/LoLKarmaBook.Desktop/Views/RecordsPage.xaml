<UserControl x:Class="LoLKarmaBook.Desktop.Views.RecordsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LoLKarmaBook.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RecordsViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">
  <UserControl.Resources>
    <Style x:Key="RecordAction" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
      <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="我的记录" Style="{StaticResource Text.Title}" />
          <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Button.Quiet}" Command="{Binding OpenDemoCommand}"
                  Margin="0,0,8,0" ToolTip="切换到内置模拟演示空间（与当前空间隔离）。"
                  AutomationProperties.Name="打开模拟演示空间">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource Icon.Flask}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.Accent}" />
              <TextBlock Text="演示空间" Margin="6,0,0,0" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}"
                  AutomationProperties.Name="刷新记录列表">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.Accent}" />
              <TextBlock Text="刷新" Margin="6,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Filter groups wrap as units; helper text never competes with their widths. -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10,14,4" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Margin="0,0,12,6">
          <TextBlock Text="状态" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                    DisplayMemberPath="Label" Width="120" AutomationProperties.Name="按状态筛选" />
        </StackPanel>
        <StackPanel Margin="0,0,12,6">
          <TextBlock Text="类别" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                    DisplayMemberPath="Label" Width="160" AutomationProperties.Name="按类别筛选" />
        </StackPanel>
        <StackPanel Margin="0,0,12,6">
          <TextBlock Text="事件时间" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                    DisplayMemberPath="Label" Width="120" AutomationProperties.Name="按事件时间筛选" />
        </StackPanel>
        <Button Style="{StaticResource Button.Row}" Content="清除筛选" Command="{Binding ClearFiltersCommand}"
                VerticalAlignment="Bottom" Margin="0,0,12,7" AutomationProperties.Name="清除全部筛选" />
        <TextBlock Text="多次记录会合并成一次" Style="{StaticResource Text.Muted}"
                   VerticalAlignment="Bottom" Margin="0,0,0,10" />
      </WrapPanel>
    </Border>

    <Grid Grid.Row="2">
      <ListBox ItemsSource="{Binding Records}" Style="{StaticResource ListBox.Records}"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               AutomationProperties.Name="记录列表"
               Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:RecordRowViewModel}">
            <Grid Margin="14,12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PlayerName}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PlayerName}"
                           Visibility="{Binding HasPlayerName, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="未保存玩家名称" Style="{StaticResource Text.Muted}"
                           Visibility="{Binding HasPlayerName, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="6,2"
                        Visibility="{Binding ShowStatusBadge, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding StatusHint}">
                  <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Text.Label}" />
                </Border>
              </Grid>

              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Row}" Command="{Binding EditCommand}" Margin="0,0,6,0"
                        AutomationProperties.Name="编辑记录" ToolTip="{Binding EditDisabledReason, TargetNullValue=编辑记录}">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Edit}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.Accent}" Width="13" Height="13" />
                    <TextBlock Text="编辑" Margin="5,0,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Row}" Content="更多 ▾" Click="OnMoreActionsClick"
                        AutomationProperties.Name="更多记录操作" ToolTip="归档、撤回、发布或删除这条记录">
                  <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Background="{StaticResource Brush.SurfaceRaised}" Foreground="{StaticResource Brush.Text}"
                                 BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" Padding="4"
                                 MinWidth="148">
                      <MenuItem Header="归档" Style="{StaticResource RecordAction}" Command="{Binding ArchiveCommand}"
                                AutomationProperties.Name="归档记录" ToolTip="{Binding ArchiveDisabledReason}" />
                      <MenuItem Header="撤回" Style="{StaticResource RecordAction}" Command="{Binding RetractCommand}"
                                AutomationProperties.Name="撤回记录" ToolTip="{Binding RetractDisabledReason}" />
                      <MenuItem Header="发布草稿" Style="{StaticResource RecordAction}" Command="{Binding PublishCommand}"
                                Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="发布草稿" ToolTip="发布为生效记录，开始参与再遇提醒。" />
                      <Separator Background="{StaticResource Brush.Border}" Margin="4,3" />
                      <MenuItem Header="删除" Style="{StaticResource RecordAction}" Command="{Binding DeleteCommand}"
                                Foreground="{StaticResource Brush.Danger}" AutomationProperties.Name="删除记录"
                                ToolTip="永久删除记录及其类别与修改日志。" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </StackPanel>

              <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0">
                  <TextBlock.ToolTip>
                    <StackPanel MaxWidth="440">
                      <TextBlock Text="{Binding CategoryText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding TagsHint}" TextWrapping="Wrap"
                                 Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                  </TextBlock.ToolTip>
                  <Run Text="{Binding CategoryText, Mode=OneWay}" /><Run Text="  " />
                  <Run Text="{Binding TagsText, Mode=OneWay}" Foreground="{StaticResource Brush.Accent}" />
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding EventDateTime}" FontSize="12"
                           Foreground="{StaticResource Brush.TextMuted}" />
              </Grid>
              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Body}" FontSize="13"
                         Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"
                         Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}">
                <TextBlock.ToolTip>
                  <TextBlock Text="{Binding Body}" MaxWidth="480" TextWrapping="Wrap" />
                </TextBlock.ToolTip>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28"
              Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
        <StackPanel HorizontalAlignment="Center">
          <Path Data="{StaticResource Icon.List}" Style="{StaticResource Icon16}" Width="34" Height="34"
                Stroke="{StaticResource Brush.BorderStrong}" HorizontalAlignment="Center" />
          <TextBlock Text="还没有符合条件的记录" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,12,0,4" />
          <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"
                     MaxWidth="560" TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Feedback occupies its own row and never covers the last record. -->
    <Border Grid.Row="3" Style="{StaticResource CardInset}" Margin="0,10,0,0"
            Background="{StaticResource Brush.DangerSoft}" BorderBrush="{StaticResource Brush.Danger}"
            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Danger}" Style="{StaticResource Text.Body}" />
    </Border>
  </Grid>
</UserControl>
