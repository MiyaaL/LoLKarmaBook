<UserControl x:Class="LoLKarmaBook.Desktop.Views.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LoLKarmaBook.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PerformanceViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>


      <!-- Hexdata 海斗分 -->
      <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
        <StackPanel DataContext="{Binding Hexdata}">
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hexdata 海斗分" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource Button.Quiet}" Content="退出登录"
                    Command="{Binding SignOutCommand}" VerticalAlignment="Center"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
          </Grid>

          <!-- 未登录：在专用浏览器窗口登录一次，回来读取会话 -->
          <StackPanel Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVis}}">
            <WrapPanel>
              <Button Style="{StaticResource Button.Primary}" Content="登录 Hexdata" Command="{Binding SignInCommand}"
                      VerticalAlignment="Center" Margin="0,0,10,6" />
              <Button Style="{StaticResource Button.Secondary}" Content="我已完成登录" Command="{Binding CompleteLoginCommand}"
                      VerticalAlignment="Center" Margin="0,0,10,6" />
            </WrapPanel>
            <Expander Header="登录遇到问题？" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="手动输入会话令牌" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                <WrapPanel>
                  <TextBox Text="{Binding TokenInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="260"
                           VerticalAlignment="Center" Margin="0,0,8,6"
                           AutomationProperties.Name="Hexdata 会话令牌"
                           ToolTip="自动读取失败时，可粘贴浏览器里的会话令牌" />
                  <Button Style="{StaticResource Button.Row}" Content="使用这个令牌" Command="{Binding UseTokenCommand}"
                          VerticalAlignment="Center" Margin="0,0,0,6" />
                </WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel>

          <!-- 已登录：查询 -->
          <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="180" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="游戏 ID（名字#编号）" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                <TextBox Text="{Binding GameIdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="要查询的游戏 ID" />
              </StackPanel>
              <Button Grid.Column="2" Style="{StaticResource Button.Row}" Content="查这个 ID"
                      Command="{Binding QueryGameCommand}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
              <Button Grid.Column="4" Style="{StaticResource Button.Primary}" Content="查我的海斗分"
                      Command="{Binding QuerySelfCommand}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
            </Grid>

          </StackPanel>

          <!-- 查询记录：点开查看，再点一次折叠 -->
          <StackPanel Margin="0,14,0,0">
            <TextBlock Text="查询记录" Style="{StaticResource Text.Heading}" Margin="0,0,0,8" />
            <TextBlock Text="还没有本地查询记录。" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:HexdataHistoryRowViewModel}">
                  <Border Style="{StaticResource CardInset}" Margin="0,0,0,6" Padding="0">
                    <StackPanel>
                      <Button Style="{StaticResource Button.Quiet}" HorizontalContentAlignment="Stretch"
                              Padding="10,8" Command="{Binding ToggleCommand}"
                              AutomationProperties.Name="展开或折叠这条查询记录">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="24" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Text.Muted}"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding GameText}" Style="{StaticResource Text.Body}"
                                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                          <TextBlock Grid.Column="2" Text="{Binding ScoreText}" FontSize="16" FontWeight="SemiBold"
                                     Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Right"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                          <TextBlock Grid.Column="3" Text="{Binding ChevronText}" Style="{StaticResource Text.Muted}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                      <StackPanel Margin="12,0,12,12"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <!-- Keep copyable text outside the header button so selecting
                             a game ID never toggles the query details. -->
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="查询玩家" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <TextBox Grid.Column="1" Text="{Binding GameText, Mode=OneWay}"
                                   Style="{StaticResource TextBox.SelectableText}" FontSize="12"
                                   AutomationProperties.Name="查询玩家 ID"
                                   AutomationProperties.HelpText="只读。拖动选择文字后按 Ctrl+C 复制，Ctrl+A 可全选完整 ID。"
                                   ToolTip="{Binding GameText}" />
                        </Grid>
                        <WrapPanel>
                          <TextBlock Text="{Binding EstimateMetaText}" Style="{StaticResource Text.Muted}"
                                     TextWrapping="Wrap" MaxWidth="680" />
                          <TextBlock Text="{Binding RegionText}" Style="{StaticResource Text.Muted}"
                                     Margin="8,0,0,0" />
                        </WrapPanel>
                        <TextBlock Text="{Binding CollectingText}" Style="{StaticResource Text.Muted}"
                                   Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasCollectingText, Converter={StaticResource BoolToVis}}" />
                                                <Grid Margin="0,8,0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="55" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="1" Text="时间" Style="{StaticResource Text.Muted}" FontSize="11" />
                          <TextBlock Grid.Column="2" Text="结果" Style="{StaticResource Text.Muted}" FontSize="11" />
                          <TextBlock Grid.Column="3" Text="英雄" Style="{StaticResource Text.Muted}" FontSize="11" />
                          <TextBlock Grid.Column="4" Text="KDA" Style="{StaticResource Text.Muted}" FontSize="11" />
                          <TextBlock Grid.Column="5" Text="时长" Style="{StaticResource Text.Muted}" FontSize="11" />
                          <TextBlock Grid.Column="6" Text="本局分" Style="{StaticResource Text.Muted}" FontSize="11" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Matches}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HexdataMatchRowViewModel}">
                              <StackPanel Margin="0,0,0,4">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <Button Grid.Column="0" Style="{StaticResource Button.Quiet}" Content="{Binding ChevronText}"
                                          Command="{Binding ToggleCommand}" Padding="0" Width="18" Height="18"
                                          FontSize="12" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"
                                          AutomationProperties.Name="展开或收起双方名单" />
                                  <TextBlock Grid.Column="1" Text="{Binding WhenText}" Style="{StaticResource Text.Muted}" />
                                  <TextBlock Grid.Column="2" Text="{Binding ResultText}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsWin}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <TextBlock Grid.Column="3" Text="{Binding ChampionText}" Style="{StaticResource Text.Body}" />
                                  <TextBlock Grid.Column="4" Text="{Binding KdaText}" Style="{StaticResource Text.Muted}" />
                                  <TextBlock Grid.Column="5" Text="{Binding DurationText}" Style="{StaticResource Text.Muted}" />
                                  <TextBlock Grid.Column="6" Text="{Binding ScoreText}" Style="{StaticResource Text.Muted}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Teams}" Margin="22,4,0,8"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HexdataTeamRowViewModel}">
                                      <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Label}" />
                                        <Grid Margin="0,2,0,2">
                                          <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                          </Grid.ColumnDefinitions>
                                          <TextBlock Text="玩家" Style="{StaticResource Text.Muted}" FontSize="11" />
                                          <TextBlock Grid.Column="1" Text="英雄" Style="{StaticResource Text.Muted}" FontSize="11" />
                                          <TextBlock Grid.Column="2" Text="KDA" Style="{StaticResource Text.Muted}" FontSize="11" />
                                          <TextBlock Grid.Column="3" Text="海斗分" Style="{StaticResource Text.Muted}" FontSize="11" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Participants}">
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:HexdataPlayerRowViewModel}">
                                              <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                  <ColumnDefinition Width="220" />
                                                  <ColumnDefinition Width="110" />
                                                  <ColumnDefinition Width="100" />
                                                  <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Name, Mode=OneWay}"
                                                         Style="{StaticResource TextBox.SelectableText}" FontSize="12"
                                                         Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,8,0"
                                                         AutomationProperties.Name="{Binding Name}"
                                                         AutomationProperties.HelpText="玩家 ID，只读。拖动选择文字后按 Ctrl+C 复制，Ctrl+A 可全选完整 ID。"
                                                         ToolTip="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Champion}" Style="{StaticResource Text.Muted}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Kda}" Style="{StaticResource Text.Muted}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Score}" Style="{StaticResource Text.Muted}" />
                                              </Grid>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 海斗分走势：横轴时间、纵轴分数、每个点一个圆 -->
          <Border Style="{StaticResource CardInset}" Margin="0,12,0,0" Padding="14,12"
                  Visibility="{Binding Chart.HasPoints, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="海斗分走势" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding Chart.AccountText}" Style="{StaticResource Text.Muted}"
                             Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource Button.Row}" Content="{Binding ChartScopeText}"
                        Command="{Binding ToggleChartScopeCommand}" HorizontalAlignment="Right"
                        Padding="8,3" AutomationProperties.Name="切换走势图统计范围" />
              </Grid>
              <Viewbox Stretch="Uniform" Height="210" Margin="0,10,0,0">
                <Canvas Width="760" Height="210">
                  <Line X1="64" Y1="14" X2="64" Y2="180" Stroke="{StaticResource Brush.Border}" StrokeThickness="1" />
                  <Line X1="64" Y1="180" X2="744" Y2="180" Stroke="{StaticResource Brush.Border}" StrokeThickness="1" />
                  <Polyline Points="{Binding Chart.LinePoints, Converter={StaticResource ChartPoints}}"
                            Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                            Visibility="{Binding Chart.HasLine, Converter={StaticResource BoolToVis}}" />

                  <!-- 每个记录一个圆点；悬停显示时间与分数 -->
                  <ItemsControl ItemsSource="{Binding Chart.Dots}" Width="760" Height="210">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Width="20" Height="20" Background="Transparent" ToolTip="{Binding Tooltip}"
                              ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000"
                              AutomationProperties.Name="{Binding Tooltip}">
                          <Ellipse Width="9" Height="9" Fill="{StaticResource Brush.Background}"
                                   Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 纵轴分数刻度 -->
                  <ItemsControl ItemsSource="{Binding Chart.YLabels}" Width="760" Height="210">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Text}" Width="{Binding Width}" TextAlignment="Right"
                                   FontSize="11" Foreground="{StaticResource Brush.TextMuted}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 横轴记录时间刻度 -->
                  <ItemsControl ItemsSource="{Binding Chart.XLabels}" Width="760" Height="210">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Text}" Width="{Binding Width}" TextAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource Brush.TextMuted}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Canvas>
              </Viewbox>
              <Grid Margin="0,4,0,0">
                <TextBlock Text="{Binding Chart.MinimumText}" Style="{StaticResource Text.Muted}"
                           HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Chart.MaximumText}" Style="{StaticResource Text.Muted}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Chart.LatestText}" Style="{StaticResource Text.Muted}"
                           HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" TextWrapping="Wrap"
                     Visibility="{Binding IsStatusError, Converter={StaticResource BoolToVis}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>

      <StackPanel Visibility="Collapsed">
      <!-- Riot API 在线查询 -->
      <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="获取近期对局" Style="{StaticResource Text.Heading}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0" TextWrapping="NoWrap" MaxWidth="620"
                         HorizontalAlignment="Left"
                         Text="{Binding LookupDescription}"  TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource Button.Primary}" Command="{Binding FetchRiotCommand}" Margin="0,0,8,0"
                      AutomationProperties.Name="获取近期对局"
                      ToolTip="按当前区服和队列读取对局。">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.OnAccent}" />
                  <TextBlock Text="获取对局" Margin="6,0,0,0"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Button.Quiet}" Command="{Binding CancelRiotCommand}"
                      Visibility="{Binding IsFetching, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="取消对局查询">
                <TextBlock Text="取消"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </Button>
            </StackPanel>
          </Grid>

          <Grid IsEnabled="{Binding CanEditLookup}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" MinWidth="150" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="1.2*" MinWidth="130" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="1.1*" MinWidth="120" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="1.1*" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0"
                        Visibility="{Binding IsRiotPlatform, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Riot ID" Style="{StaticResource Text.Label}" Margin="0,0,0,4"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBox Text="{Binding RiotIdText, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Riot ID，格式 名称#标签"
                       ToolTip="示例：Hide on bush#KR1" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="0"
                        Visibility="{Binding IsMainlandPlatform, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="本机账号" Style="{StaticResource Text.Label}" Margin="0,0,0,4"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding LocalAccountText}" Style="{StaticResource Text.Body}" Margin="0,7,0,0"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
              <TextBlock Text="区服" Style="{StaticResource Text.Label}" Margin="0,0,0,4"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}"
                        DisplayMemberPath="Display" AutomationProperties.Name="区服" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="4">
              <TextBlock Text="队列" Style="{StaticResource Text.Label}" Margin="0,0,0,4"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <ComboBox ItemsSource="{Binding Queues}" SelectedItem="{Binding SelectedQueue}"
                        AutomationProperties.Name="队列筛选" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="6">
              <TextBlock Text="局数" Style="{StaticResource Text.Label}" Margin="0,0,0,4"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <ComboBox ItemsSource="{Binding Counts}" SelectedItem="{Binding SelectedCount}"
                        AutomationProperties.Name="拉取局数" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0"
                        Visibility="{Binding IsRiotPlatform, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Riot API Key" Style="{StaticResource Text.Label}" Margin="0,10,0,4"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnApiKeyChanged"
                           AutomationProperties.Name="Riot API Key"
                           ToolTip="填写 Riot 开发者 Key。" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,7"
                        Visibility="{Binding IsRiotPlatform, Converter={StaticResource BoolToVis}}">
              <CheckBox Content="记住 Key" IsChecked="{Binding RememberApiKey}"
                        AutomationProperties.Name="记住 Riot API Key"
                        Foreground="{StaticResource Brush.TextMuted}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3" Style="{StaticResource Text.Muted}"
                       VerticalAlignment="Bottom" Margin="0,0,0,7" TextWrapping="NoWrap"
                       Text="{Binding FetchProgressText}"
                       Visibility="{Binding HasFetchProgress, Converter={StaticResource BoolToVis}}"  TextTrimming="CharacterEllipsis"/>
          </Grid>

          <TextBlock Text="{Binding KeyNoticeText}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                     Margin="0,8,0,0" TextWrapping="NoWrap"
                     Visibility="{Binding HasKeyNotice, Converter={StaticResource BoolToVis}}"  TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding RiotSourceText}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                     Margin="0,4,0,0" TextWrapping="NoWrap"
                     Visibility="{Binding HasRiotSource, Converter={StaticResource BoolToVis}}"  TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>

      <!-- 数据来源 -->
      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding DatasetSource}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding DatasetMeta}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding LastImportPath}" Style="{StaticResource Text.Mono}" Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasLastImport, Converter={StaticResource BoolToVis}}"  TextWrapping="NoWrap"/>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding SampleText}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 错误 -->
      <Border Style="{StaticResource CardInset}" Margin="0,0,0,10"
              Background="{StaticResource Brush.DangerSoft}" BorderBrush="{StaticResource Brush.Danger}"
              Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Path Data="{StaticResource Icon.Warning}" Style="{StaticResource Icon16}" Stroke="{StaticResource Brush.Danger}" />
          <TextBlock Grid.Column="1" Text="{Binding ErrorText}" Foreground="{StaticResource Brush.Danger}" Style="{StaticResource Text.Body}"
                     Margin="8,0,0,0" TextWrapping="NoWrap"  TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>

      <!-- 空状态 -->
      <Border Style="{StaticResource Card}" Padding="32" Margin="0,0,0,10"
              Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
        <StackPanel HorizontalAlignment="Center">
          <Path Data="{StaticResource Icon.Chart}" Width="40" Height="40" Stretch="Uniform"
                Stroke="{StaticResource Brush.BorderStrong}" StrokeThickness="1.3" HorizontalAlignment="Center" />
          <TextBlock Text="尚未计算估算 ELO 分" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,12,0,4"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          <TextBlock Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="560"
                     Text="选择区服和队列后，点击获取对局。"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>

      <!-- 结果 -->
      <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 总分 -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="估算 ELO 分" Style="{StaticResource Text.Label}" VerticalAlignment="Center"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" Background="{StaticResource Brush.AccentSoft}" CornerRadius="9" Padding="8,2"
                        Visibility="{Binding HasEstimate, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding EstimateTagText}" Style="{StaticResource Text.Muted}" FontSize="11"
                             Foreground="{StaticResource Brush.Accent}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </Border>
              </Grid>
              <TextBlock Text="{Binding EstimateText}" Style="{StaticResource Text.Score}" Margin="0,4,0,0"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <ProgressBar Style="{StaticResource Bar.Score}" Value="{Binding EstimateQ50Ticks, Mode=OneWay}" Margin="0,8,0,0" />
              <Grid Margin="0,2,0,0">
                <TextBlock Text="{Binding EstimateQ10, StringFormat=刻度 {0}}" Style="{StaticResource Text.Muted}" FontSize="11"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding EstimateQ90, StringFormat=至 {0}}" Style="{StaticResource Text.Muted}" FontSize="11"
                           HorizontalAlignment="Right"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <TextBlock Text="{Binding EstimateDetailText}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" TextWrapping="NoWrap"  TextTrimming="CharacterEllipsis"/>

              <Border Style="{StaticResource Divider}" />
              <TextBlock Text="近期表现分（0–100）" Style="{StaticResource Text.Label}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Text.Body}" FontSize="20" FontWeight="SemiBold"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding AvailabilityText}" Style="{StaticResource Text.Muted}"
                           VerticalAlignment="Bottom" TextAlignment="Right" MaxWidth="160" TextWrapping="NoWrap"  TextTrimming="CharacterEllipsis"/>
              </Grid>
              <ProgressBar Style="{StaticResource Bar.Score}" Value="{Binding ScoreBarValue, Mode=OneWay}" Margin="0,6,0,0" />
              <Border Style="{StaticResource Divider}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="胜率" Style="{StaticResource Text.Muted}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding WinRateText}" Style="{StaticResource Text.Body}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="聚合 KDA" Style="{StaticResource Text.Muted}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding KdaText}" Style="{StaticResource Text.Body}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="归一化分 / 原始加权分" Style="{StaticResource Text.Muted}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding NormalizedText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding RawText, Mode=OneWay}" />
                </TextBlock>
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="样本量" Style="{StaticResource Text.Muted}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding SampleText}" Style="{StaticResource Text.Body}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <Border Style="{StaticResource Divider}" />
              <TextBlock Text="缺失分项" Style="{StaticResource Text.Label}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding MissingText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                         Foreground="{StaticResource Brush.Warning}" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding MissingText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                         Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding WeightsText}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>

          <!-- 分项 -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
              <TextBlock Text="分项与贡献" Style="{StaticResource Text.Heading}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="分项展示近期表现与对应贡献。"
                         Style="{StaticResource Text.Muted}" Margin="0,2,0,10"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ComponentRowViewModel}">
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Muted}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <ProgressBar Style="{StaticResource Bar.Score}" Value="{Binding BarValue, Mode=OneWay}" />
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding PointsText}" Style="{StaticResource Text.Body}"
                                 VerticalAlignment="Center" HorizontalAlignment="Right"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <!-- 原始行预览 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
          <StackPanel>
            <Grid>
              <TextBlock Text="导入数据预览（最近 200 局）" Style="{StaticResource Text.Heading}"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding MatchCount, StringFormat=共 {0} 局}" Style="{StaticResource Text.Muted}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <DataGrid ItemsSource="{Binding MatchPreview}" MaxHeight="280" Margin="0,10,0,0"
                      AutomationProperties.Name="导入数据预览表">
              <DataGrid.Columns>
                <DataGridTextColumn Header="对局编号" Binding="{Binding MatchId}" Width="*" />
                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="60" />
                <DataGridTextColumn Header="K/D/A" Binding="{Binding Kda}" Width="90" />
                <DataGridTextColumn Header="对英雄伤害" Binding="{Binding Damage}" Width="110" />
                <DataGridTextColumn Header="获得金币" Binding="{Binding Gold}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
      </Grid>

    </StackPanel>
      </StackPanel>
  </ScrollViewer>
</UserControl>
