<Window x:Class="LoLKarmaBook.Desktop.Views.NoteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LoLKarmaBook.Desktop.ViewModels"
        Title="编辑记录" Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Background="{StaticResource Brush.Surface}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource Size.Body}"
        Foreground="{StaticResource Brush.Text}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
    <StackPanel DataContext="{Binding}">
      <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />

      <TextBlock Text="类别（可多选）" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:CategoryChipViewModel}">
            <CheckBox Style="{StaticResource CheckBox.Chip}" Content="{Binding DisplayName}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Hint}"
                      AutomationProperties.Name="{Binding DisplayName}" Margin="0,0,8,8" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="备注（选填，最多 500 字）" Style="{StaticResource Text.Label}" Margin="0,8,0,6" />
      <TextBox Style="{StaticResource TextBox.Multiline}"
               Text="{Binding Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               MaxLength="500" AutomationProperties.Name="备注" />
      <TextBlock Text="{Binding BodyCountText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                 HorizontalAlignment="Right" />

      <TextBlock Text="标签（英雄 / 装备，可模糊搜索）" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
      <ItemsControl ItemsSource="{Binding Tags}" Margin="0,0,0,6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:TagChipViewModel}">
            <Button Style="{StaticResource Button.Row}" Command="{Binding RemoveCommand}"
                    Content="{Binding DisplayName}" Margin="0,0,6,6"
                    AutomationProperties.Name="{Binding RemoveLabel}"
                    ToolTip="点击移除这个标签" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBox Text="{Binding TagQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="搜索英雄或装备"
               ToolTip="输入官方名、民间叫法或拼音，例如「无尽」「狐狸」「jyhy」" />
      <ItemsControl ItemsSource="{Binding TagSuggestions}" Margin="0,6,0,0"
                    Visibility="{Binding HasTagSuggestions, Converter={StaticResource BoolToVis}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:TagSuggestionViewModel}">
            <Button Style="{StaticResource Button.Quiet}" HorizontalContentAlignment="Left"
                    Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" Margin="0,0,0,2" Padding="8,4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding KindBadge}" FontWeight="SemiBold" Margin="0,0,6,0" />
                <TextBlock Text="{Binding DisplayName}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <CheckBox Content="永久有效" IsChecked="{Binding IsPermanentReminder, Mode=TwoWay}"
                  VerticalAlignment="Center" AutomationProperties.Name="提醒永久有效" />
        <TextBlock Text="或有效期（天）" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                   Margin="14,0,8,0" />
        <TextBox Text="{Binding ReminderDaysText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Width="80" IsEnabled="{Binding CanEditReminderDays}"
                 AutomationProperties.Name="提醒有效期天数" />
      </StackPanel>

      <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.Warning}"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"
                Content="保存" Margin="0,0,8,0" AutomationProperties.Name="保存记录修改" />
        <Button Style="{StaticResource Button.Quiet}" Content="取消" Click="OnCancelClick"
                AutomationProperties.Name="取消编辑" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
